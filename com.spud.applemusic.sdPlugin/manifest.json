{"$schema":"https://schemas.elgato.com/streamdeck/plugins/manifest.json","UUID":"com.spud.applemusic","Name":"Apple Music","Version":"1.1.0.0","Author":"Spud","Description":"Control Apple Music on Windows from Stream Deck. Play, pause, skip, shuffle, repeat, show the current song, and use Stream Deck+ dials for volume and scrubbing.","Category":"Apple Music","CategoryIcon":"imgs/plugin/category-icon","Icon":"imgs/plugin/icon","CodePath":"bin/plugin.js","SDKVersion":2,"Software":{"MinimumVersion":"6.5"},"Nodejs":{"Version":"20"},"OS":[{"Platform":"windows","MinimumVersion":"10"}],"ApplicationsToMonitor":{"windows":["AppleMusic.exe","iTunes.exe"]},"Actions":[{"Name":"Play/Pause","UUID":"com.spud.applemusic.play-pause","Icon":"imgs/actions/play-pause/icon","Tooltip":"Toggle play and pause. The key shows whether audio is playing.","PropertyInspectorPath":"ui/session.html","Controllers":["Keypad"],"DisableAutomaticStates":true,"SupportedInMultiActions":true,"States":[{"Image":"imgs/actions/play-pause/play","Name":"Paused","Title":"Paused","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/play-pause/pause","Name":"Playing","Title":"Playing","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"}]},{"Name":"Next Track","UUID":"com.spud.applemusic.next","Icon":"imgs/actions/next/icon","Tooltip":"Skip to the next track.","Controllers":["Keypad"],"SupportedInMultiActions":true,"States":[{"Image":"imgs/actions/next/key","ShowTitle":false}]},{"Name":"Previous Track","UUID":"com.spud.applemusic.previous","Icon":"imgs/actions/previous/icon","Tooltip":"Go back to the previous track.","Controllers":["Keypad"],"SupportedInMultiActions":true,"States":[{"Image":"imgs/actions/previous/key","ShowTitle":false}]},{"Name":"Now Playing","UUID":"com.spud.applemusic.now-playing","Icon":"imgs/actions/now-playing/icon","Tooltip":"Album art with the title and artist. Refreshes while the song changes.","PropertyInspectorPath":"ui/session.html","Controllers":["Keypad"],"DisableCaching":true,"States":[{"Image":"imgs/actions/now-playing/key","ShowTitle":true,"TitleAlignment":"bottom","FontSize":10,"TitleColor":"#FFFFFF"}]},{"Name":"Shuffle","UUID":"com.spud.applemusic.shuffle","Icon":"imgs/actions/shuffle/icon","Tooltip":"Toggle shuffle. Shows On or Off when Windows reports it. Otherwise sends Apple Music's shortcut.","PropertyInspectorPath":"ui/shuffle.html","Controllers":["Keypad"],"DisableAutomaticStates":true,"SupportedInMultiActions":true,"States":[{"Image":"imgs/actions/shuffle/unknown","Name":"Unknown","Title":"Shuffle","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/shuffle/off","Name":"Off","Title":"Off","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/shuffle/on","Name":"On","Title":"On","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"}]},{"Name":"Repeat","UUID":"com.spud.applemusic.repeat","Icon":"imgs/actions/repeat/icon","Tooltip":"Cycle repeat off, all, and one when Windows reports it. Otherwise sends Apple Music's shortcut.","PropertyInspectorPath":"ui/repeat.html","Controllers":["Keypad"],"DisableAutomaticStates":true,"SupportedInMultiActions":true,"States":[{"Image":"imgs/actions/repeat/unknown","Name":"Unknown","Title":"Repeat","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/repeat/off","Name":"Off","Title":"Off","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/repeat/all","Name":"All","Title":"All","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"},{"Image":"imgs/actions/repeat/one","Name":"One","Title":"One","ShowTitle":true,"TitleAlignment":"bottom","FontSize":11,"TitleColor":"#FFFFFF"}]},{"Name":"Volume","UUID":"com.spud.applemusic.volume","Icon":"imgs/actions/volume/icon","Tooltip":"Turn to change volume. Press or tap to mute.","PropertyInspectorPath":"ui/volume.html","Controllers":["Encoder"],"Encoder":{"layout":"$B1","TriggerDescription":{"Rotate":"Change volume","Push":"Mute","Touch":"Mute"}},"States":[{"Image":"imgs/actions/volume/key"}]},{"Name":"Scrub","UUID":"com.spud.applemusic.scrub","Icon":"imgs/actions/scrub/icon","Tooltip":"Turn to move through the song. Press or tap to play or pause.","PropertyInspectorPath":"ui/scrub.html","Controllers":["Encoder"],"Encoder":{"layout":"$B1","TriggerDescription":{"Rotate":"Scrub the song","Push":"Play / Pause","Touch":"Play / Pause"}},"States":[{"Image":"imgs/actions/scrub/key"}]}]}